# Copy this file to .env and replace each placeholder with the value for the
# deployment environment. Never commit the real .env file.
PORT=5005
MONGO_DB_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional in development; production defaults are 1h and 30d if omitted.
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
# Comma-separated exact browser origins; set this to the client's Netlify dashboard URL on Render.
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DVLA Vehicle Enquiry Service (VES). Keep this server-side only.
DVLA_API_KEY=

# Google Maps Platform — Geocoding API. Use a SERVER-side key here, not the
# key embedded in the Flutter app. The app's key is usually restricted to
# Android/iOS app bundles, which blocks server requests (no app context to
# check). Create a separate key in the same Google Cloud project, restrict
# it by API (Geocoding API only) rather than by app, and enable "Geocoding
# API" for it in Google Cloud Console if not already on.
GOOGLE_MAPS_API_KEY=
